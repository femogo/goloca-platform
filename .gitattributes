# Normalización de finales de línea — repo multiplataforma (Windows dev → Linux infra)
# Por defecto: Git decide y normaliza a LF en el repo
* text=auto

# Scripts y configs que SE EJECUTAN en Linux: SIEMPRE LF, pase lo que pase
*.sh        text eol=lf
*.bash      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
*.service   text eol=lf

# Documentación: LF también (consistencia, GitHub lo prefiere)
*.md        text eol=lf

# Archivos específicos de Windows: CRLF
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binarios: no tocar nunca
*.png       binary
*.jpg       binary
*.pdf       binary
*.gz        binary
*.zip       binary